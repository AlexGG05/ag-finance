# In Arcane als Stack-Variablen eintragen; lokal nach .env kopieren.
# Keine echten Zugangsdaten ins Repository schreiben.
APP_URL=https://finanzen.example.de
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_FROM=AG Finance <finanzen@example.de>
SMTP_USER=finanzen@example.de
SMTP_PASS=

# latest folgt main. Für feste Releases z. B. 1.0.0 oder sha-abcdef0 nutzen.
IMAGE_TAG=latest
HOST_PORT=3000
# Für einen Reverse Proxy auf dem Docker-Host. Siehe README für Container-Proxys.
BIND_ADDRESS=127.0.0.1
